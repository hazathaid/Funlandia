{
  "name": "petualangan-angka",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Petualangan Angka — game hitung-hitungan offline untuk anak 5-8 tahun",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/generate-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "audit:offline": "node scripts/audit-offline.mjs",
    "audit:contrast": "node scripts/check-contrast.mjs",
    "verify": "npm run lint && npm run audit:offline && npm run audit:contrast && npm test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource/baloo-2": "^5.1.0",
    "@fontsource/nunito": "^5.1.0",
    "framer-motion": "^11.11.17",
    "howler": "^2.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/howler": "^2.2.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
