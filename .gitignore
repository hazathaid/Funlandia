# ============================================================
# SECRETS — JANGAN PERNAH DI-COMMIT
# Keystore hilang / ke-commit = tidak bisa update APK selamanya.
# Template yang aman di-commit: android/keystore.properties.example
# ============================================================
*.jks
*.keystore
keystore.properties
android/keystore.properties
**/keystore.properties

